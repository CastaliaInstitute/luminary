# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp

# Environment and secrets
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/
coverage/
.cache/
tmp/

# Logs
*.log

# Raw NOAA source rasters for the bathymetry build. These are large public
# downloads (the CUDEM tile alone is 151 MB, past GitHub's file limit) and are
# reproducible from the identifiers documented in
# scripts/build-ocean-bathymetry.py. The derived depth grid is committed under
# tools/ocean-sim/ instead.
data/nubble/*.tif
data/nubble/*.bag

# Host build of the ocean solver
tools/ocean-sim/ocean-sim
